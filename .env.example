# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model used for Pass 1 (bulk per-review tagging) - cheap/fast, generous free-tier quota
PASS1_MODEL=gemini-2.5-flash

# Model used for Pass 2 (aggregate synthesis) - quality matters, called once
PASS2_MODEL=gemini-2.5-pro

# Password to unlock the Admin Re-run tab in the Streamlit app. Change before deploying.
ADMIN_PASSWORD=changeme123
