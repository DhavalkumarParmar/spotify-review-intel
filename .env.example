# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model used for Pass 1 (bulk per-review tagging) - cheap/fast, generous free-tier quota
PASS1_MODEL=gemini-2.5-flash

# Model used for Pass 2 (aggregate synthesis), called once.
# Defaults to Flash because Gemini Pro has zero free-tier quota unless your
# Google Cloud project has billing linked (still free within Pro's own
# free-tier allowance once linked - billing just unlocks eligibility).
# Set to gemini-2.5-pro if you've linked billing and want higher quality synthesis.
PASS2_MODEL=gemini-2.5-flash

# Password to unlock the Admin Re-run tab in the Streamlit app. Change before deploying.
ADMIN_PASSWORD=changeme123
