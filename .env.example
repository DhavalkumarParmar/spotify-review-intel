# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Provider for each pass: "gemini" (cloud, free tier is very limited - see
# below) or "lmstudio" (a local OpenAI-compatible server like LM Studio,
# running on YOUR OWN machine - no cost, no daily quota, but you must run
# tag_reviews.py/synthesize.py on that same machine with LM Studio's local
# server started).
PASS1_PROVIDER=gemini
PASS2_PROVIDER=gemini

# Model used for Pass 1 (bulk per-review tagging).
# - gemini provider: a Gemini model name, e.g. gemini-2.5-flash
# - lmstudio provider: the exact model identifier shown in LM Studio's
#   "Developer" tab / API Usage (e.g. "qwen3-4b-thinking-2507")
PASS1_MODEL=gemini-2.5-flash

# Model used for Pass 2 (aggregate synthesis), called once.
PASS2_MODEL=gemini-2.5-flash

# Base URL for the lmstudio provider's OpenAI-compatible server.
# Default matches LM Studio's default local server address.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Max tokens per LM Studio response. "Thinking"/reasoning local models can spend
# thousands of tokens on internal reasoning before writing the actual answer -
# too low a value here means the response gets cut off with no real answer at
# all (you'll see "LM Studio returned empty content" errors). Raise this if
# that happens with a reasoning model.
LMSTUDIO_MAX_TOKENS=8192

# Reviews per Pass 1 batch call. Gemini Flash handles 8 reliably. Smaller
# local models (2-4B parameters) are less reliable at following complex
# batched-array JSON schemas - try 3-4 for those, and check the tagged
# output quality with --limit before scaling up.
BATCH_SIZE=8

# NOTE on Gemini free tier: actual measured daily quota for gemini-2.5-flash
# on a fresh API key was only 20 requests/day (RPD) - much lower than
# published estimates. Gemini Pro models have ZERO free-tier quota unless
# your Google Cloud project has billing linked. If you don't want to link
# billing, use PASS1_PROVIDER=lmstudio / PASS2_PROVIDER=lmstudio instead.

# Password to unlock the Admin Re-run tab in the Streamlit app. Change before deploying.
ADMIN_PASSWORD=changeme123
